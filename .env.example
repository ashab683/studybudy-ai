# ============================================
# StudyBuddy AI — Environment Configuration
# ============================================

# Ollama local endpoint (Default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Open-weight model name (Default: gemma3:4b)
OLLAMA_MODEL=gemma3:4b

# Express server port (Default: 3001)
PORT=3001

# Frontend client origin for CORS (Default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# Timeout for Ollama inference requests in ms (Default: 120000 -> 2 minutes)
REQUEST_TIMEOUT_MS=120000
